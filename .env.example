# ─── Django Core ───────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=your-very-long-random-secret-key-here
DJANGO_SETTINGS_MODULE=config.settings.development
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ─── Database (PostgreSQL) ──────────────────────────────────────────────────────
# Full DSN format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://lex_user:lex_pass@localhost:5432/lex_chambers

# ─── Cloudinary (Media Storage) ────────────────────────────────────────────────
# Sign up at https://cloudinary.com/ — free tier is sufficient
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ─── Telegram Bot Notifications ────────────────────────────────────────────────
# 1. Create a bot via @BotFather on Telegram — it gives you the token
# 2. Start a chat with your bot, then visit:
#    https://api.telegram.org/bot<TOKEN>/getUpdates  to get your chat_id
# These can also be set via Django admin in SiteConfig — env vars are fallback defaults
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Email (optional – for future email notifications) ──────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@lexchambers.in

# ─── Production Only ───────────────────────────────────────────────────────────
# DJANGO_SETTINGS_MODULE=config.settings.production
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
